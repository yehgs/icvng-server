# ============================================================================
# icvng-server — .env.example
#
# Every variable here is one the server actually reads. Generated by
# enumerating process.env usage across the codebase, so there are no invented
# names and nothing real is missing.
#
# Copy to `.env` and fill in. Never commit the filled version.
# ============================================================================


# ── CORE ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/icvng

# Public base URL of THIS API. Used to build webhook and callback URLs, so it
# must be the externally reachable address, not localhost, in production.
SERVER_BASE_URL=https://api.i-coffee.ng


# ── AUTH / TOKENS ───────────────────────────────────────────────────────────
# Three separate secrets. Do not reuse one value across them — that defeats
# the point of having separate access and refresh tokens.
JWT_SECRET_KEY=
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=


# ── CORS / FRONTEND ORIGINS ─────────────────────────────────────────────────
# One storefront origin per country domain, plus the admin panel.
# The numbered variants are all read — they are not leftovers.
FRONTEND_URL=https://i-coffee.ng
FRONTEND_URL1=https://i-coffee.tg
FRONTEND_URL2=https://i-coffee.bj
FRONTEND_URL3=https://i-coffee.it
FRONTEND_URL4=http://localhost:5173

ADMIN_URL=https://admin.i-coffee.ng
ADMIN_FRONTEND_URL=https://admin.i-coffee.ng
ADMIN_FRONTEND_URL1=http://localhost:5174
ADMIN_FRONTEND_URL2=

# Storefront origin used for product-request links.
REQUEST_FRONTEND_URL=https://i-coffee.ng


# ── EMAIL: RESEND (default provider) ────────────────────────────────────────
# Get from resend.com → API Keys. One key covers every country; the
# per-country key field in the admin UI exists only for markets billed
# separately.
#
# The admin UI can also store this key in the database, where it TAKES
# PRECEDENCE over this variable. Prefer this env var in production — a key
# here never ends up in a database backup.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# IMPORTANT — the from-address is NOT set here. It is configured in
# Settings → Email Provider, per country. Resend rejects any send whose
# from-domain is unverified, and a free-mail domain (gmail.com, yahoo.com)
# can never be verified because you don't own it. That is what produced the
# "gmail.com domain is not verified" 403.
#
# Verified in your Resend account: i-coffee.ng, i-coffee.tg
# NOT yet verified:               i-coffee.bj, i-coffee.it
# Benin and Italy sends will 403 until those two are added and verified.


# ── EMAIL: SMTP (fallback provider) ─────────────────────────────────────────
# Only used when the active provider is SMTP, or as automatic fallback when
# Resend fails. Gmail requires an APP PASSWORD (Google Account → 2-Step
# Verification → App passwords), not the account password. App passwords are
# revoked whenever the account password changes — which is what produced the
# "535-5.7.8 Username and Password not accepted" error.
EMAIL_USER=your.mailbox@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional per-country SMTP identities. Suffix is the ISO country code.
# When absent, the shared credentials above are used — content is still
# correctly localized per country, only the sending mailbox is shared.
EMAIL_USER_NG=
EMAIL_APP_PASSWORD_NG=
EMAIL_FROM_NAME_NG=I-Coffee Nigeria

EMAIL_USER_TG=
EMAIL_APP_PASSWORD_TG=
EMAIL_FROM_NAME_TG=I-Coffee Togo

EMAIL_USER_BJ=
EMAIL_APP_PASSWORD_BJ=
EMAIL_FROM_NAME_BJ=I-Coffee Bénin

EMAIL_USER_IT=
EMAIL_APP_PASSWORD_IT=
EMAIL_FROM_NAME_IT=I-Coffee Italia


# ── INTERNAL NOTIFICATION RECIPIENTS ────────────────────────────────────────
DIRECTOR_EMAIL=director@i-coffee.ng
WAREHOUSE_ADMIN_EMAIL=warehouse@i-coffee.ng


# ── PAYMENTS ────────────────────────────────────────────────────────────────
# Paystack is NIGERIA-ONLY (config/countries/index.js → payments.paystack).
# The gateway guard in order.controller.js enforces that; these keys are only
# ever used for NG.
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx

# Stripe serves EVERY country, Nigeria included — it is how an NG customer
# pays in a foreign currency.
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# From the Stripe dashboard webhook endpoint. Without it, signature
# verification fails and orders are never created from Stripe payments.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Direct bank transfer fallback values. The authoritative, country-scoped
# account details live in the bankTransferSettings collection, edited by
# IT/DIRECTOR in the admin panel — these are only a legacy default.
BANK_NAME=
ACCOUNT_NAME=
ACCOUNT_NUMBER=


# ── MEDIA ───────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET_KEY=


# ── EXCHANGE RATES ──────────────────────────────────────────────────────────
# Multiple providers so one outage doesn't freeze multi-currency pricing.
# At least one is needed for NGN ↔ XOF/EUR conversion.
CURRENCYAPI_KEY=
EXCHANGERATES_API_KEY=
FIXER_API_KEY=
FREECURRENCY_API_KEY=


# ── AI / TRANSLATION ────────────────────────────────────────────────────────
# Used by scripts/translateUiLocales.js to fill es/pt/nl/ar/hi/zh from en.js,
# and by product content translation.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini


# ── SEARCH / SCRAPING ───────────────────────────────────────────────────────
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
SERP_API_KEY=


# ── GOOGLE OAUTH ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── FEATURE FLAGS ───────────────────────────────────────────────────────────
# Country scoping enforcement. Leave ON in production — turning it off
# removes the country boundary between markets.
COUNTRY_ENFORCE=true

# Verbose per-route audit logging. Noisy; development only.
AUDIT_ROUTES=false
